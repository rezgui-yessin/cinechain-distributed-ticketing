              "raw": "{\n  \"deliveryType\": \"IN_SEAT\",\n  \"ticketId\": 22,\n  \"notes\": \"Warm melted butter on popcorn\",\n  \"items\": [\n    { \"itemId\": 1, \"quantity\": 1, \"options\": \"Large Sweet\" },\n    { \"itemId\": 2, \"quantity\": 1, \"options\": \"Cold\" }\n  ]\n}"
