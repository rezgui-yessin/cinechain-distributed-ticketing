{
  "info": {
    "name": "CineChain API End-to-End Collection",
    "_postman_id": "c19b33a0-7b5e-4c48-8df0-cinechain001",
    "description": "Complete Postman collection for CineChain with sample payloads for all endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "customerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "createdMovieId", "value": "1" },
    { "key": "createdCinemaId", "value": "1" },
    { "key": "createdHallId", "value": "1" },
    { "key": "createdScreeningId", "value": "13" },
    { "key": "createdTicketId", "value": "22" },
    { "key": "createdQrCodeData", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test_customer@cinechain.com\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Rivera\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cinechain.com\",\n  \"password\": \"Admin@CineChain2024!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@cinechain.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Movies Management",
      "item": [
        {
          "name": "Insert Movie (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Gladiator II (IMAX Premiere)\",\n  \"description\": \"Years after witnessing Maximus, Lucius enters the Colosseum.\",\n  \"genre\": \"Action / Drama\",\n  \"language\": \"English\",\n  \"durationMinutes\": 148,\n  \"releaseDate\": \"2026-11-20\",\n  \"rating\": 8.8,\n  \"posterUrl\": \"https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800\",\n  \"trailerUrl\": \"https://www.youtube.com/watch?v=4rgYUipGJNo\",\n  \"status\": \"NOW_SHOWING\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/movies", "host": ["{{baseUrl}}"], "path": ["api", "movies"] }
          }
        },
        {
          "name": "Get All Movies (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/movies", "host": ["{{baseUrl}}"], "path": ["api", "movies"] }
          }
        }
      ]
    },
    {
      "name": "3. Cinemas & Halls",
      "item": [
        {
          "name": "Insert Cinema (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CineChain Dolby Cinema\",\n  \"address\": \"42 Avenue des Champs-Elysees\",\n  \"city\": \"Paris\",\n  \"phone\": \"+33 1 55 00 00 00\",\n  \"email\": \"paris@cinechain.fr\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?w=800\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/cinemas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "cinemas"] }
          }
        },
        {
          "name": "Insert Hall (Admin)",
          "request": {
            "method": "POST",
