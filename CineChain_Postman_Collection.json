              "raw": "{\n  \"screeningId\": 13,\n  \"seatIds\": [1],\n  \"holderName\": \"Sarah Connor\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        }
      ]
    },
    {
      "name": "5. Concessions & In-Seat Snacks",
      "item": [
        {
          "name": "Get Gourmet Menu",
          "request": {
            "method": "GET",
