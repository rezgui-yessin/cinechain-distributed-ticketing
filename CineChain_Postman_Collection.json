            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hall 1 - Dolby Atmos Luxe\",\n  \"totalCapacity\": 80,\n  \"cinemaId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/halls", "host": ["{{baseUrl}}"], "path": ["api", "admin", "halls"] }
          }
        }
      ]
    },
    {
