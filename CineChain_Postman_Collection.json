            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": 1,\n  \"hallId\": 1,\n  \"startTime\": \"2026-11-25T20:00:00\",\n  \"endTime\": \"2026-11-25T22:30:00\",\n  \"price\": 15.50\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/screenings", "host": ["{{baseUrl}}"], "path": ["api", "admin", "screenings"] }
